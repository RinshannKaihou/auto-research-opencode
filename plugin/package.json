{
  "name": "auto-research-opencode",
  "version": "0.1.0",
  "description": "Autonomous research for OpenCode V2: coordinator, node sessions, specialists and a research board",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts",
    "./package.json": "./package.json"
  },
  "files": ["index.ts", "tui.tsx", "rpc.ts", "src", "python/**/*.py", "README.md"],
