  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.18",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/bun": "^1.3.10",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
